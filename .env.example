NODE_ENV=development
PORT=3000

# Postgres via DATABASE_URL or individual vars
DATABASE_URL=postgres://Hans:1234@localhost:5432/tachin_verde
DB_NAME=nombre_de_tu_base
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432

# JWT
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Broker MQTT para los tachos inteligentes
MQTT_BROKER_URL=mqtt://192.168.18.143:1883
MQTT_TOPIC_TACHO_ESTADO=smartbin/status
MQTT_TOPIC_EVENTO_RECICLAJE=smartbin/recycle
# Opcionales: configurar ambas variables para un broker autenticado
MQTT_USERNAME=
MQTT_PASSWORD=

# Otros
LOG_LEVEL=info
