NODE_ENV=development
PORT=3000

# Postgres via DATABASE_URL or individual vars
DATABASE_URL=postgres://user:password@localhost:5432/dbname
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# JWT
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# API key independiente para los tachos inteligentes
TACHO_API_KEY=replace_with_a_long_random_secret

# Otros
LOG_LEVEL=info
