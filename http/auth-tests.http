@baseUrl = http://localhost:3000/api
@userToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTIyOTI2NzQsImV4cCI6MTc5MjM3OTA3NCwiYXVkIjoiaXMyLWFwaSIsImlzcyI6ImlzMi1iYWNrZW5kIiwic3ViIjoiMTEifQ.Tm4bGMx7IzkWvKjDX6UmSHIV9lVViyJGBGd4mKX3HiY
@adminToken = reemplaza-con-el-token-del-login-de-admin

### 1) Registro de usuario normal
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{
  "cod_user": "20215643",
  "nombre": "Angello",
  "tipo": "usuario",
  "contraseña": "123456"
}

### 2) El registro público rechaza la creación de administradores
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{
  "cod_user": "20240101",
  "nombre": "Admin Principal",
  "tipo": "admin",
  "contraseña": "admin123"
}

### 3) Login de usuario
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "cod_user": "20215643",
  "contraseña": "123456"
}

### 4) Login de administrador (requiere una cuenta admin provisionada previamente)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "cod_user": "20240101",
  "contraseña": "admin123"
}

### 5) Acceso protegido para usuario
GET {{baseUrl}}/usuarios
Authorization: Bearer {{userToken}}

### 6) Acceso protegido para admin
GET {{baseUrl}}/tachos
Authorization: Bearer {{adminToken}}

### 7) Usuario normal intentando acceder a ruta admin
POST {{baseUrl}}/tachos
Authorization: Bearer {{userToken}}
Content-Type: application/json

{}

### 8) Usuario inexistente
GET {{baseUrl}}/usuarios
Authorization: Bearer token-invalido

### 9) Login con contraseña incorrecta
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "cod_user": "20256534",
  "contraseña": "passincorrecta"
}

### 10) Registro con cod_user inválido
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{
  "cod_user": "ABC123",
  "nombre": "Usuario Malo",
  "tipo": "usuario",
  "contraseña": "123456"
}
